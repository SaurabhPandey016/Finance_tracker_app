PORT=10000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Append &connect_timeout=10&pool_timeout=10 to prefer fast connection failures.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintrack?schema=public&connect_timeout=10&pool_timeout=10"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fintrack?schema=public&connect_timeout=10&pool_timeout=10"
JWT_SECRET="replace-with-at-least-32-character-secret"
JWT_EXPIRES_IN="7d"


